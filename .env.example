# Public (exposed to client)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Session-Verschlüsselung (min. 32 Zeichen, z. B. openssl rand -base64 32)
# Secrets: siehe Kommentar in nuxt.config.ts (dotenv lädt .env.local + .env vor dem Build)
NUXT_SESSION_PASSWORD=

# Optional: sichtbarer App-Name in Nextclouds Login-Flow-V2-Dialog
# NUXT_APP_NAME=Eselsohr

# Optional: komplette Neon/Postgres-URL; wenn leer, werden die PG*-Variablen verwendet.
# DATABASE_URL=

# Neon / Postgres für Public-Share-Mapping
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# Netlify: Build nutzt Node Functions (`npm run build` → `nuxt build --preset netlify`).
